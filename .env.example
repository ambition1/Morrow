# 功能：Docker Compose 部署参数示例。
# 作者：xuanli
# 创建时间：2026-10-27 01:21:20
# Compose 项目名决定数据卷前缀，部署后不要随意修改。
COMPOSE_PROJECT_NAME=morrow
# 本地构建镜像标签；更新时使用新的标签，保留旧标签用于回滚。
MORROW_IMAGE_TAG=local
# 仅回环地址发布，供本机调试或已有的 HTTPS 反向代理使用。
MORROW_HTTP_PORT=3000
# 根据服务器内存和笔记库规模调整。
MORROW_MEMORY_LIMIT=1g
# 使用 compose.https.yaml 时填写真实域名及证书通知邮箱。
MORROW_DOMAIN=notes.example.com
# 用于公网证书申请及续期通知。
ACME_EMAIL=admin@example.com
# HTTPS 网关对外监听；正式服务器保持下面的默认值。
CADDY_BIND_ADDRESS=0.0.0.0
# HTTP 入口，用于证书验证和跳转。
CADDY_HTTP_PORT=80
# 浏览器的 HTTPS 入口。
CADDY_HTTPS_PORT=443
# 固定网关镜像系列，可按验证结果更新。
CADDY_IMAGE=caddy:2.10-alpine
